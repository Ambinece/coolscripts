-- Animation replacement dictionary
local DEFAULT_TO_REPLACEMENT = {
	["136252471123500"] = "rbxassetid://89252407304675", -- Run
	["131082534135875"] = "rbxassetid://138754221537146", -- Idle
	["108018357044094"] = "rbxassetid://131235528875091", -- Walk
}

local player = game.Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local animator = character:WaitForChild("Humanoid"):WaitForChild("Animator")

local conn

-- Function to clean IDs so they always match the dictionary
local function normalizeId(id)
	-- Strip everything except the number
	local num = string.match(id, "%d+")
	return num or id
end

local function startOverride()
	if conn then return end
	conn = animator.AnimationPlayed:Connect(function(track)
		local cleanId = normalizeId(track.Animation.AnimationId)
		local replacement = DEFAULT_TO_REPLACEMENT[cleanId]
		if replacement then
			-- Stop the default track
			track:Stop()
			-- Load and play the replacement
			local newAnim = Instance.new("Animation")
			newAnim.AnimationId = replacement
			local newTrack = animator:LoadAnimation(newAnim)
			newTrack:Play()
		end
	end)
end

local function stopOverride()
	if conn then
		conn:Disconnect()
		conn = nil
	end
end

-- Example UI binding (C00lLib)
local HttpService = game:GetService("HttpService")
local raw = game:HttpGetAsync("https://raw.githubusercontent.com/Ambinece/C00lHub/refs/heads/main/C00lLib")
local MainLibrary = loadstring(raw)()

local UI = MainLibrary:CreateUI("Anim Override")

UI:CreateToggle("Toggle Anim Override", function(state)
	if state then
		startOverride()
	else
		stopOverride()
	end
end)
